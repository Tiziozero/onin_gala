// cfunctions.gala
//
// Raw POSIX socket API.
// Linux / Unix.
//
// This file should be imported directly by modules which use
// these functions. Imports are not transitively exported.


// ============================================================
// SOCKETS
// ============================================================

extern fn socket(
    domain: i32,
    type: i32,
    protocol: i32,
): i32;

extern fn connect(
    sockfd: i32,
    addr: ^byte,
    addrlen: u32,
): i32;

extern fn bind(
    sockfd: i32,
    addr: ^byte,
    addrlen: u32,
): i32;

extern fn listen(
    sockfd: i32,
    backlog: i32,
): i32;

extern fn accept(
    sockfd: i32,
    addr: ^byte,
    addrlen: ^u32,
): i32;

extern fn send(
    sockfd: i32,
    buffer: ^byte,
    length: u64,
    flags: i32,
): i64;

extern fn recv(
    sockfd: i32,
    buffer: ^byte,
    length: u64,
    flags: i32,
): i64;

extern fn shutdown(
    sockfd: i32,
    how: i32,
): i32;

extern fn close(
    fd: i32,
): i32;


// ============================================================
// SOCKET OPTIONS
// ============================================================

extern fn setsockopt(
    sockfd: i32,
    level: i32,
    option: i32,
    value: ^byte,
    value_len: u32,
): i32;


// ============================================================
// BYTE ORDER
// ============================================================

extern fn htons(value: u16): u16;
extern fn ntohs(value: u16): u16;

extern fn htonl(value: u32): u32;
extern fn ntohl(value: u32): u32;


// ============================================================
// IPv4
// ============================================================

extern fn inet_addr(
    address: ^byte,
): u32;
