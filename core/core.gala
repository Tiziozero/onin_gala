// core.gala
//
// Small runtime layer: C bindings, `any` helpers, a Builder-based
// formatter (no C formatting), println and printfmt.

alias int = i32;

@link("/lib/x86_64-linux-gnu/libc.so.6")
@link("/lib/x86_64-linux-gnu/libm.so.6")
import "./cfunctions.gala";


// ============================================================
// ANY
// ============================================================

// `any` is { ptr, i64 }: `data` points at the spilled value,
// `id` is the concrete type id.

fn any_as::<$T>(v: any): ^T {
    if v.id == type_id(T) {
        return cast(^T)v.data;
    }
    return 0;
}

fn raw_data(v: []$T): ^T {
    if len(v) == 0 { return 0; }
    return &v[0];
}

// ============================================================
// STRING HELPERS
// ============================================================

// Pointer to the first byte. Not NUL-terminated.
fn cstr(s: string): ^byte {
    return &s[0];
}

fn str_cmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

// ============================================================
// BUILDER
// ============================================================

// Fixed-size output buffer. Lives on the caller's stack, so it is
// thread-safe. Output past 1024 bytes is dropped.
// Later: swap `data` for an allocator-backed growable buffer; only
// push_byte has to change.

struct Builder {
    data: [1024]byte,
    count: i64,
}

fn push_byte(b: ^Builder, c: byte) {
    if b^.count < 1024 {
        b^.data[b^.count] = c;
        b^.count += 1;
    }
}

fn push_string(b: ^Builder, s: string) {
    i := 0;
    while i < len(s) {
        push_byte(b, s[i]);
        i += 1;
    }
}

// The only place that touches C. If cfunctions declares `write`,
// use write(1, &b.data[0], b.count) instead.
fn flush_stdout(b: ^Builder) {
    printf(&("%.*s")[0], b^.count, &b^.data[0]);
}

// ============================================================
// NUMBERS
// ============================================================

fn fmt_u64(b: ^Builder, v: u64) {
    // find the largest power of 10 <= v, then emit digits forward
    div: u64 = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        push_byte(b, cast(byte)(48 + (v / div) % 10));   // 48 = '0'
        div = div / 10;
    }
}

fn fmt_i64(b: ^Builder, v: i64) {
    if v < 0 {
        push_byte(b, 45);                                // '-'
        // negate in u64 so i64 min works
        fmt_u64(b, cast(u64)0 - cast(u64)v);
    } else {
        fmt_u64(b, cast(u64)v);
    }
}

// Up to 6 fractional digits, rounded, trailing zeros trimmed.
// Values >= 2^64 are not supported.
fn fmt_f64(b: ^Builder, x: f64) {
    if x != x {
        push_string(b, "nan");
        return;
    }
    v := x;
    if v < 0.0 {
        push_byte(b, 45);
        v = 0.0 - v;
    }
    if v - v != 0.0 {
        push_string(b, "inf");
        return;
    }
    if v >= 18446744073709551616.0 {
        push_string(b, "<too big>");
        return;
    }

    ip := cast(u64)v;
    scaled := cast(u64)((v - cast(f64)ip) * 1000000.0 + 0.5);
    if scaled >= 1000000 {
        ip += 1;
        scaled -= 1000000;
    }
    fmt_u64(b, ip);

    places := 6;
    while places > 0 {
        if scaled % 10 != 0 { break; }
        scaled = scaled / 10;
        places -= 1;
    }
    if places > 0 {
        push_byte(b, 46);                                // '.'
        div: u64 = 1;
        k := 1;
        while k < places {
            div = div * 10;
            k += 1;
        }
        while div > 0 {
            push_byte(b, cast(byte)(48 + (scaled / div) % 10));
            div = div / 10;
        }
    }
}

// ============================================================
// ANY FORMATTING
// ============================================================

fn try_int::<$T>(b: ^Builder, v: any): bool {
    p := any_as::<T>(v);
    if p == 0 { return false; }
    fmt_i64(b, cast(i64)(p^));
    return true;
}

fn try_uint::<$T>(b: ^Builder, v: any): bool {
    p := any_as::<T>(v);
    if p == 0 { return false; }
    fmt_u64(b, cast(u64)(p^));
    return true;
}

fn try_float::<$T>(b: ^Builder, v: any): bool {
    p := any_as::<T>(v);
    if p == 0 { return false; }
    fmt_f64(b, cast(f64)(p^));
    return true;
}

fn fmt_any(b: ^Builder, v: any) {
    ps := any_as::<string>(v);
    if ps != 0 {
        push_string(b, ps^);
        return;
    }

    if try_int::<i64>(b, v) { return; }
    if try_int::<i32>(b, v) { return; }
    if try_int::<i16>(b, v) { return; }
    if try_int::<i8>(b, v) { return; }
    if try_uint::<u64>(b, v) { return; }
    if try_uint::<u32>(b, v) { return; }
    if try_uint::<u16>(b, v) { return; }
    if try_uint::<u8>(b, v) { return; }
    if try_float::<f64>(b, v) { return; }
    if try_float::<f32>(b, v) { return; }

    pb := any_as::<bool>(v);
    if pb != 0 {
        if pb^ {
            push_string(b, "true");
        } else {
            push_string(b, "false");
        }
        return;
    }

    // structs, pointers, fns: needs type info, see notes
    push_string(b, "<?>");
}

// ============================================================
// FORMAT
// ============================================================

// "{}" takes the next arg, "{{" / "}}" are literal braces.
// Missing args print "<missing>", extra args are ignored.
fn format_into(b: ^Builder, fmt_str: string, args: []any) {
    n := len(fmt_str);
    i := 0;
    arg := 0;

    while i < n {
        c := fmt_str[i];
        if c == 123 {                                    // '{'
            if i + 1 < n && fmt_str[i + 1] == 123 {
                push_byte(b, 123);
                i += 2;
            } else if i + 1 < n && fmt_str[i + 1] == 125 {
                if arg < len(args) {
                    fmt_any(b, args[arg]);
                } else {
                    push_string(b, "<missing>");
                }
                arg += 1;
                i += 2;
            } else {
                push_byte(b, c);
                i += 1;
            }
        } else if c == 125 && i + 1 < n && fmt_str[i + 1] == 125 {   // '}'
            push_byte(b, 125);
            i += 2;
        } else {
            push_byte(b, c);
            i += 1;
        }
    }
}

// printfmt("a is {}, b is {}\n", a, b)
fn printfmt(fmt_str: string, args: ..any) {
    b :=  Builder{ data=[1024]byte{}, count=0};
    b.count = 0;
    format_into(&b, fmt_str, args);
    flush_stdout(&b);
}

// ============================================================
// PRINTLN
// ============================================================

fn println(data: ..any) {
    b :=  Builder{ data=[1024]byte{}, count=0};
    b.count = 0;

    i := 0;
    for v in data {
        if i > 0 {
            push_byte(&b, 32);                           // ' '
        }
        fmt_any(&b, v);
        i += 1;
    }
    push_byte(&b, 10);                                   // '\n'

    flush_stdout(&b);
}

fn generic_fn(a: $T) {
    println("a:", a);
}
