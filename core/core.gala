// core.gala
//
// Runtime layer: C bindings, `any` helpers, a Builder-based
// formatter driven by type_info, println and print.

alias int = i32;

@link("/lib/x86_64-linux-gnu/libc.so.6")
@link("/lib/x86_64-linux-gnu/libm.so.6")
import "./cfunctions.gala";


// ============================================================
// ANY
// ============================================================

// `any` is { ptr, i64 }: `data` points at the spilled value,
// `id` is the concrete type id.

fn any_as::<$T>(v: any): ^T {
    if v.id == type_id(T) {
        return cast(^T)v.data;
    }
    return 0;
}

fn raw_data(v: []$T): ^T {
    if len(v) == 0 { return 0; }
    return &v[0];
}

// ============================================================
// STRING HELPERS
// ============================================================

// Pointer to the first byte. Not NUL-terminated.
fn cstr(s: string): ^byte {
    return &s[0];
}

fn str_cmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

// ============================================================
// BUILDER
// ============================================================

// Fixed-size output buffer on the caller's stack (thread-safe).
// Output past BUF_SIZE bytes is dropped.
BUF_SIZE :: 4096;

struct Builder {
    data: [BUF_SIZE]byte,
    count: i64,
}

fn push_byte(b: ^Builder, c: byte) {
    if b^.count < BUF_SIZE {
        b^.data[b^.count] = c;
        b^.count += 1;
    }
}

fn push_string(b: ^Builder, s: string) {
    i := 0;
    while i < len(s) {
        push_byte(b, s[i]);
        i += 1;
    }
}

// The only place that touches C.
fn flush_stdout(b: ^Builder) {
    printf(&("%.*s")[0], b^.count, &b^.data[0]);
}

// ============================================================
// NUMBERS
// ============================================================

fn fmt_u64(b: ^Builder, v: u64) {
    div: u64 = 1;
    while v / div >= 10 {
        div = div * 10;
    }
    while div > 0 {
        push_byte(b, cast(byte)(48 + (v / div) % 10));   // 48 = '0'
        div = div / 10;
    }
}

fn fmt_i64(b: ^Builder, v: i64) {
    if v < 0 {
        push_byte(b, 45);                                // '-'
        // negate in u64 so i64 min works
        fmt_u64(b, cast(u64)0 - cast(u64)v);
    } else {
        fmt_u64(b, cast(u64)v);
    }
}

fn fmt_hex(b: ^Builder, v: u64) {
    push_string(b, "0x");
    div: u64 = 1;
    while v / div >= 16 {
        div = div * 16;
    }
    while div > 0 {
        d := (v / div) % 16;
        if d < 10 {
            push_byte(b, cast(byte)(48 + d));            // '0'
        } else {
            push_byte(b, cast(byte)(87 + d));            // 'a' - 10
        }
        div = div / 16;
    }
}

// Up to 6 fractional digits, rounded, trailing zeros trimmed.
// Values >= 2^64 are not supported.
fn fmt_f64(b: ^Builder, x: f64) {
    if x != x {
        push_string(b, "nan");
        return;
    }
    v := x;
    if v < 0.0 {
        push_byte(b, 45);
        v = 0.0 - v;
    }
    if v - v != 0.0 {
        push_string(b, "inf");
        return;
    }
    if v >= 18446744073709551616.0 {
        push_string(b, "<too big>");
        return;
    }

    ip := cast(u64)v;
    scaled := cast(u64)((v - cast(f64)ip) * 1000000.0 + 0.5);
    if scaled >= 1000000 {
        ip += 1;
        scaled -= 1000000;
    }
    fmt_u64(b, ip);

    places := 6;
    while places > 0 {
        if scaled % 10 != 0 { break; }
        scaled = scaled / 10;
        places -= 1;
    }
    if places > 0 {
        push_byte(b, 46);                                // '.'
        div: u64 = 1;
        k := 1;
        while k < places {
            div = div * 10;
            k += 1;
        }
        while div > 0 {
            push_byte(b, cast(byte)(48 + (scaled / div) % 10));
            div = div / 10;
        }
    }
}

// ============================================================
// VALUE FORMATTING (driven by type_info)
// ============================================================

fn offset_ptr(p: rawptr, bytes: i64): rawptr {
    return cast(rawptr)(cast(i64)p + bytes);
}

fn fmt_int_at(b: ^Builder, data: rawptr, size: i64) {
    if size == 8 {
        p := cast(^i64)data;
        fmt_i64(b, p^);
    } else if size == 4 {
        p := cast(^i32)data;
        fmt_i64(b, cast(i64)(p^));
    } else if size == 2 {
        p := cast(^i16)data;
        fmt_i64(b, cast(i64)(p^));
    } else {
        p := cast(^i8)data;
        fmt_i64(b, cast(i64)(p^));
    }
}

fn fmt_uint_at(b: ^Builder, data: rawptr, size: i64) {
    if size == 8 {
        p := cast(^u64)data;
        fmt_u64(b, p^);
    } else if size == 4 {
        p := cast(^u32)data;
        fmt_u64(b, cast(u64)(p^));
    } else if size == 2 {
        p := cast(^u16)data;
        fmt_u64(b, cast(u64)(p^));
    } else {
        p := cast(^u8)data;
        fmt_u64(b, cast(u64)(p^));
    }
}

fn fmt_float_at(b: ^Builder, data: rawptr, size: i64) {
    if size == 8 {
        p := cast(^f64)data;
        fmt_f64(b, p^);
    } else {
        p := cast(^f32)data;
        fmt_f64(b, cast(f64)(p^));
    }
}

// Formats the value at `data` of type `id`. `nested` is true inside
// structs/arrays/slices, where strings get quoted.
fn fmt_value(b: ^Builder, data: rawptr, id: i64, nested: bool) {
    info := type_info(id);
    k := info^.kind;

    if k == KIND_INT {
        fmt_int_at(b, data, info^.size);
        return;
    }
    if k == KIND_UINT || k == KIND_BYTE || k == KIND_RUNE {
        fmt_uint_at(b, data, info^.size);
        return;
    }
    if k == KIND_FLOAT {
        fmt_float_at(b, data, info^.size);
        return;
    }
    if k == KIND_BOOL {
        p := cast(^bool)data;
        if p^ {
            push_string(b, "true");
        } else {
            push_string(b, "false");
        }
        return;
    }
    if k == KIND_STRING {
        p := cast(^string)data;
        if nested { push_byte(b, 34); }                  // '"'
        push_string(b, p^);
        if nested { push_byte(b, 34); }
        return;
    }
    if k == KIND_POINTER {
        p := cast(^u64)data;
        if p^ == 0 {
            push_string(b, "nil");
        } else {
            fmt_hex(b, p^);
        }
        return;
    }
    if k == KIND_ANY {
        p := cast(^any)data;
        fmt_value(b, p^.data, p^.id, nested);
        return;
    }

    if k == KIND_STRUCT {
        push_string(b, info^.name);
        if len(info^.fields) == 0 {
            push_string(b, " {}");
            return;
        }
        push_string(b, " { ");
        i := 0;
        for f in info^.fields {
            if i > 0 { push_string(b, ", "); }
            push_string(b, f.name);
            push_string(b, " = ");
            fmt_value(b, offset_ptr(data, f.offset), f.typeid, true);
            i += 1;
        }
        push_string(b, " }");
        return;
    }

    if k == KIND_ARRAY {
        esize := type_info(info^.elem)^.size;
        push_byte(b, 91);                                // '['
        i: i64 = 0;
        while i < info^.count {
            if i > 0 { push_string(b, ", "); }
            fmt_value(b, offset_ptr(data, i * esize), info^.elem, true);
            i += 1;
        }
        push_byte(b, 93);                                // ']'
        return;
    }

    if k == KIND_SLICE {
        // layout is { ptr, i64 }
        ptr_p := cast(^rawptr)data;
        cnt_p := cast(^i64)offset_ptr(data, 8);
        esize := type_info(info^.elem)^.size;
        push_byte(b, 91);
        i: i64 = 0;
        while i < cnt_p^ {
            if i > 0 { push_string(b, ", "); }
            fmt_value(b, offset_ptr(ptr_p^, i * esize), info^.elem, true);
            i += 1;
        }
        push_byte(b, 93);
        return;
    }

    // fns, unions, anything else: just the type name
    push_string(b, info^.name);
}

fn fmt_any(b: ^Builder, v: any) {
    fmt_value(b, v.data, v.id, false);
}

// ============================================================
// FORMAT
// ============================================================

// "{}" takes the next arg, "{{" / "}}" are literal braces.
// Missing args print "<missing>", extra args are ignored.
fn format_into(b: ^Builder, fmt_str: string, args: []any) {
    n := len(fmt_str);
    i := 0;
    arg := 0;

    while i < n {
        c := fmt_str[i];
        if c == 123 {                                    // '{'
            if i + 1 < n && fmt_str[i + 1] == 123 {
                push_byte(b, 123);
                i += 2;
            } else if i + 1 < n && fmt_str[i + 1] == 125 {
                if arg < len(args) {
                    fmt_any(b, args[arg]);
                } else {
                    push_string(b, "<missing>");
                }
                arg += 1;
                i += 2;
            } else {
                push_byte(b, c);
                i += 1;
            }
        } else if c == 125 && i + 1 < n && fmt_str[i + 1] == 125 {   // '}'
            push_byte(b, 125);
            i += 2;
        } else {
            push_byte(b, c);
            i += 1;
        }
    }
}

// print("a is {}, b is {}\n", a, b)
fn print(fmt_str: string, args: ..any) {
    b := Builder{ data=[BUF_SIZE]byte{}, count=0 };
    format_into(&b, fmt_str, args);
    flush_stdout(&b);
}

// ============================================================
// PRINTLN
// ============================================================

fn println(data: ..any) {
    b := Builder{ data=[BUF_SIZE]byte{}, count=0 };

    i := 0;
    for v in data {
        if i > 0 {
            push_byte(&b, 32);                           // ' '
        }
        fmt_any(&b, v);
        i += 1;
    }
    push_byte(&b, 10);                                   // '\n'

    flush_stdout(&b);
}

fn generic_fn(a: $T) {
    println("a:", a);
}


struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

extern fn nanosleep(req: ^Timespec, rem: ^Timespec): i32;

fn sleep_ms(ms: i64) {
    if ms <= 0 {
        return;
    }
    ts := Timespec{ tv_sec = ms / 1000, tv_nsec = (ms % 1000) * 1000000 };
    // POSIX allows req and rem to be the same object, so on an early wakeup
    // ts already holds the time left. The only error that can happen here is
    // EINTR (tv_nsec is always in range), so -1 means "interrupted, go again".
    while nanosleep(&ts, &ts) == -1 {
    }
}
