// core.gala
//
// Small C/POSIX-independent runtime layer.
// Mostly C standard-library bindings plus a few Gala conveniences.

// ============================================================
// C STDIO
// ============================================================

@link("/lib/x86_64-linux-gnu/libc.so.6")
@link("/lib/x86_64-linux-gnu/libm.so.6")
import "./cfunctions.gala";


// ============================================================
// ANY
// ============================================================

// Mirror of the `any` ABI:
//
//     { ptr, i64 }
//
// `data` points at the spilled value.
// `id` identifies its concrete Gala type.
//
// This allows `any` values to be inspected without compiler-level
// support for accessing their fields directly.

fn any_as::<$T>(v: any): ^T {
    if v.id == type_id(T) {
        return cast(^T)v.data;
    }
    return 0;
}

// ============================================================
// STRING HELPERS
// ============================================================

// Convert a Gala string to a C string pointer.
//
// NOTE:
// This is only safe for functions that do not require the string
// to be NUL-terminated beyond the existing representation.
//
// For a Gala string containing embedded NULs, C will stop at the
// first NUL.

fn cstr(s: string): ^byte {
    return &s[0];
}


// ============================================================
// PRINTLN
// ============================================================

fn println(data: ..any) {
    i := 0;

    for v in data {
        if i > 0 {
            printf(&(" ")[0]);
        }

        s := any_as::<string>(v);
        if s != 0 {
            printf(&("%.*s")[0], len(s^), &s^[0]);
        } else {
            n_i64 := any_as::<i64>(v);
            n_u64 := any_as::<u64>(v);
            n_i32 := any_as::<i32>(v);
            n_u32 := any_as::<u32>(v);
            n_i16 := any_as::<i16>(v);
            n_u16 := any_as::<u16>(v);
            n_i8 := any_as::<i8>(v);
            n_u8 := any_as::<u8>(v);
            n_f64 := any_as::<f64>(v);
            n_f32 := any_as::<f32>(v);
            b := any_as::<bool>(v);

            if n_i64 != 0 {
                printf(&("%lld")[0], n_i64^);
            } else if n_u64 != 0 {
                printf(&("%llu")[0], n_u64^);
            } else if n_i32 != 0 {
                printf(&("%d")[0], n_i32^);
            } else if n_u32 != 0 {
                printf(&("%u")[0], n_u32^);
            } else if n_i16 != 0 {
                printf(&("%d")[0], n_i16^);
            } else if n_u16 != 0 {
                printf(&("%u")[0], n_u16^);
            } else if n_i8 != 0 {
                printf(&("%d")[0], n_i8^);
            } else if n_u8 != 0 {
                printf(&("%u")[0], n_u8^);
            } else if n_f64 != 0 {
                printf(&("%g")[0], n_f64^);
            } else if n_f32 != 0 {
                printf(&("%g")[0], n_f32^);
            } else if b != 0 {
                if b^ {
                    printf(&("true")[0]);
                } else {
                    printf(&("false")[0]);
                }
            } else {
                printf(&("<?>")[0]);
            }
        }

        i += 1;
    }

    printf(&("\n")[0]);
}



fn str_cmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) { if a[i] != b[i] { return false; } }
    return true;
}

fn generic_fn(a: $T) {
    println("a:", a);
}

