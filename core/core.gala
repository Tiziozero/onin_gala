// core.gala
//
// Small C/POSIX-independent runtime layer.
// Mostly C standard-library bindings plus a few Gala conveniences.

// ============================================================
// C STDIO
// ============================================================

@link("/lib/x86_64-linux-gnu/libc.so.6")
@link("/lib/x86_64-linux-gnu/libm.so.6")
import "./cfunctions.gala";


// ============================================================
// ANY
// ============================================================

// Mirror of the `any` ABI:
//
//     { ptr, i64 }
//
// `data` points at the spilled value.
// `id` identifies its concrete Gala type.
//
// This allows `any` values to be inspected without compiler-level
// support for accessing their fields directly.

struct Any {
    data: ^byte,
    id: i64,
}


// ============================================================
// STRING HELPERS
// ============================================================

// Convert a Gala string to a C string pointer.
//
// NOTE:
// This is only safe for functions that do not require the string
// to be NUL-terminated beyond the existing representation.
//
// For a Gala string containing embedded NULs, C will stop at the
// first NUL.

fn cstr(s: string): ^byte {
    return &s[0];
}


// ============================================================
// PRINTLN
// ============================================================
fn println(data: ..any) {
    i := 0;

    for v in data {
        if i > 0 {
            printf(&(" ")[0]);
        }

        a := transmute(Any)v;
        id := a.id;

        if id == type_id(string) {
            s := (transmute(^string)a.data)^;

            // Gala strings have an explicit length and are not
            // necessarily NUL-terminated.
            printf(&("%.*s")[0], len(s), &s[0]);

        } else if id == type_id(i64) {
            printf(&("%lld")[0], (transmute(^i64)a.data)^);

        } else if id == type_id(u64) {
            printf(&("%llu")[0], (transmute(^u64)a.data)^);

        } else if id == type_id(i32) {
            printf(&("%d")[0], (transmute(^i32)a.data)^);

        } else if id == type_id(u32) {
            printf(&("%u")[0], (transmute(^u32)a.data)^);

        } else if id == type_id(i16) {
            printf(&("%d")[0], (transmute(^i16)a.data)^);

        } else if id == type_id(u16) {
            printf(&("%u")[0], (transmute(^u16)a.data)^);

        } else if id == type_id(i8) {
            printf(&("%d")[0], (transmute(^i8)a.data)^);

        } else if id == type_id(u8) {
            printf(&("%u")[0], (transmute(^u8)a.data)^);

        } else if id == type_id(f64) {
            printf(&("%g")[0], (transmute(^f64)a.data)^);

        } else if id == type_id(f32) {
            // The C variadic ABI promotes f32 -> double.
            printf(&("%g")[0], (transmute(^f32)a.data)^);

        } else if id == type_id(bool) {
            if (transmute(^bool)a.data)^ {
                printf(&("true")[0]);
            } else {
                printf(&("false")[0]);
            }

        } else {
            printf(&("<?>")[0]);
        }

        i += 1;
    }

    printf(&("\n")[0]);
}


fn str_cmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) { if a[i] != b[i] { return false; } }
    return true;
}
