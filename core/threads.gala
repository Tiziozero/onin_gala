// core/threads.gala: pthread bindings plus a thin wrapper API.
// Layouts are for Linux x86-64 glibc (pthread_t = 8 bytes, mutex = 40,
// cond = 48). Locals avoid module-level names (no shadowing in gala).

import "./mem.gala";
import "./core.gala";
import "./cfunctions.gala";


// --- types ----------------------------------------------------------------

// Opaque, 8-byte aligned storage. Init in place and never copy after init.
struct Thread {
    handle: i64,
    started: bool,
}

// Box carrying the user's fn and argument into the new thread.
struct ThreadStart {
    func: fn(arg: rawptr),
    arg: rawptr,
}

// --- threads --------------------------------------------------------------

// The box is allocated on one thread and freed on another, so it always
// uses the heap allocator, never base_allocator (arenas aren't thread safe).
fn thread_trampoline(box: rawptr): rawptr {
    st := transmute(^ThreadStart)box;
    func := st^.func;
    user_arg := st^.arg;
    dealloc(box, size_of(ThreadStart), heap_allocator());
    func(user_arg);
    return NULL;
}

// Runs func(user) on a new thread. Check `.started` on the result.
// `user` must outlive the thread (heap or global, not a stack local you leave).
fn thread_spawn(func: fn(arg: ^$T), user: ^T): Thread {
    th := Thread{ handle=0, started=false };
    h := heap_allocator();
    raw := alloc(size_of(ThreadStart), 16, h);
    if raw == NULL {
        return th;
    }
    st := transmute(^ThreadStart)raw;
    st^ = ThreadStart{ func=transmute(fn(arg:rawptr))func, arg=cast(rawptr)user };

    rc := pthread_create(&th.handle, NULL, thread_trampoline, raw);
    if rc != 0 {
        dealloc(raw, size_of(ThreadStart), h);
        return th;
    }
    th.started = true;
    return th;
}

// Waits for the thread to finish. Returns 0 on success (an errno otherwise).
fn thread_join(th: Thread): i32 {
    return pthread_join(th.handle, transmute(^rawptr)NULL);
}

// The thread cleans up on its own; it can't be joined afterwards.
fn thread_detach(th: Thread): i32 {
    return pthread_detach(th.handle);
}

fn thread_self(): Thread {
    return Thread{ handle=pthread_self(), started=true };
}

fn thread_equal(a_th: Thread, b_th: Thread): bool {
    return pthread_equal(a_th.handle, b_th.handle) != 0;
}

fn thread_yield() {
    sched_yield();
}


// --- mutex ----------------------------------------------------------------

fn mutex_init(mu: ^Mutex): i32 {
    return pthread_mutex_init(mu, NULL);
}

fn mutex_lock(mu: ^Mutex): i32 {
    return pthread_mutex_lock(mu);
}

// true if the lock was taken
fn mutex_trylock(mu: ^Mutex): bool {
    return pthread_mutex_trylock(mu) == 0;
}

fn mutex_unlock(mu: ^Mutex): i32 {
    return pthread_mutex_unlock(mu);
}

fn mutex_destroy(mu: ^Mutex): i32 {
    return pthread_mutex_destroy(mu);
}

// --- condition variable ---------------------------------------------------

fn cond_init(cv: ^Cond): i32 {
    return pthread_cond_init(cv, NULL);
}

// The mutex must be locked; wait in a loop (spurious wakeups happen).
fn cond_wait(cv: ^Cond, mu: ^Mutex): i32 {
    return pthread_cond_wait(cv, mu);
}

fn cond_signal(cv: ^Cond): i32 {
    return pthread_cond_signal(cv);
}

fn cond_broadcast(cv: ^Cond): i32 {
    return pthread_cond_broadcast(cv);
}

fn cond_destroy(cv: ^Cond): i32 {
    return pthread_cond_destroy(cv);
}
