// net.gala

import "./cfunctions.gala";


// ============================================================
// Constants
// ============================================================

AF_INET: i32 = 2;
SOCK_STREAM: i32 = 1;
IPPROTO_TCP: i32 = 6;

SOL_SOCKET: i32 = 1;
SO_REUSEADDR: i32 = 2;

SHUT_RD: i32 = 0;
SHUT_WR: i32 = 1;
SHUT_RDWR: i32 = 2;


// ============================================================
// C _socket structures
// ============================================================

// Linux:
//
// struct sockaddr_in {
//     sa_family_t    sin_family;   // u16
//     in_port_t      sin_port;     // u16
//     struct in_addr sin_addr;     // u32
//     unsigned char  sin_zero[8];
// };
//
// Total = 16 bytes.

struct SockAddrIn {
    family: u16,
    port: u16,
    address: u32,
    zero: [8]byte,
}


// ============================================================
// Gala _socket type
// ============================================================

struct TcpSocket {
    fd: i32,
}


// ============================================================
// Internal helpers
// ============================================================

fn make_address(address: string, port: u16): SockAddrIn {
    a := SockAddrIn{0, 0, 0, [8]byte{}};

    a.family = cast(u16)AF_INET;
    a.port = htons(port);
    a.address = inet_addr(&(address)[0]);

    return a;
}


// ============================================================
// Client
// ============================================================

fn tcp_connect(address: string, port: u16): TcpSocket {
    fd := socket(
        AF_INET,
        SOCK_STREAM,
        IPPROTO_TCP,
    );

    if fd < 0 {
        return TcpSocket{fd=-1};
    }

    addr := make_address(address, port);

    result := connect(
        fd,
        cast(^byte)&addr,
        16,
    );

    if result < 0 {
        close(fd);
        return TcpSocket{fd=-1};
    }

    return TcpSocket{fd=fd};
}


// ============================================================
// Server
// ============================================================

fn tcp_listen(port: u16, backlog: i32): TcpSocket {
    fd := socket(
        AF_INET,
        SOCK_STREAM,
        IPPROTO_TCP,
    );

    if fd < 0 {
        return TcpSocket{fd=-1};
    }


    // Allow reusing the address after the server exits.

    reuse: i32 = 1;

    result := setsockopt(
        fd,
        SOL_SOCKET,
        SO_REUSEADDR,
        cast(^byte)&reuse,
        4,
    );

    if result < 0 {
        close(fd);
        return TcpSocket{fd=-1};
    }


    // 0.0.0.0 = listen on all IPv4 interfaces.

    addr := SockAddrIn{
        family=cast(u16)AF_INET,
        port=htons(port),
        address=0,
        zero=[8]byte{},
    };

    result = bind(
        fd,
        cast(^byte)&addr,
        16,
    );

    if result < 0 {
        close(fd);
        return TcpSocket{fd=-1};
    }


    result = listen(fd, backlog);

    if result < 0 {
        close(fd);
        return TcpSocket{fd=-1};
    }

    return TcpSocket{fd=fd};
}


fn tcp_accept(server: TcpSocket): TcpSocket {
    fd := accept(
        server.fd,
        0,
        0,
    );

    return TcpSocket{fd=fd};
}


// ============================================================
// Sending
// ============================================================

fn tcp_send(_socket: TcpSocket, data: []byte): i64 {
    return send(
        _socket.fd,
        &data[0],
        cast(u64)len(data),
        0,
    );
}


// ============================================================
// Receiving
// ============================================================

fn tcp_recv(_socket: TcpSocket, buffer: []byte): i64 {
    return recv(
        _socket.fd,
        &buffer[0],
        cast(u64)len(buffer),
        0,
    );
}


// ============================================================
// Closing
// ============================================================

fn tcp_close(_socket: TcpSocket) {
    if _socket.fd >= 0 {
        close(_socket.fd);
    }
}


// ============================================================
// Shutdown
// ============================================================

fn tcp_shutdown(_socket: TcpSocket, how: i32): i32 {
    return shutdown(_socket.fd, how);
}
