struct DynArray { items: []$T, len: i64 }   // items.len is the capacity

fn dyn_make(cap: i64, fill: $T): DynArray(T) {
    return DynArray(T){make_slice(fill, cap), 0};
}

fn dyn_push(a: ^DynArray($T), v: T) {
    if a^.len == len(a^.items) {
        new_cap := len(a^.items) * 2;
        if new_cap == 0 { new_cap = 4; }
        bigger := make_slice(v, new_cap);
        i := 0;
        while i < a^.len {
            bigger[i] = a^.items[i];
            i += 1;
        }
        a^.items = bigger;
    }
    a^.items[a^.len] = v;
    a^.len += 1;
}

fn dyn_get(a: ^DynArray($T), idx: i64): T { return a^.items[idx]; }
fn dyn_slice(a: ^DynArray($T)): []T { return a^.items[0:a^.len]; }

fn main() {
    xs := dyn_make(4, 0);              // DynArray(i64), T from the literal
    n := 0;
    while n < 10 {
        dyn_push(&xs, n * n);
        n += 1;
    }
    println(dyn_get(&xs, 3));          // 9
    for v in dyn_slice(&xs) { println(v); }
}
