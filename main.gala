import "core/core.gala";

struct abc {
    x, y: f32,
}
struct v2 {
    x, y: f32,
}
fn f(a: []$T, b: fn(i: T): T) {
    for i in a {
        println(cast(i32)b(i));
    }
}
fn g(a: $T, b: T): T {
    return a + b;
}
fn a_dot_b(a: $A, b: $B): f32 {
    return a.x * b.x + a.y * b.y;
}
import "core/mem.gala";
fn filter(m: []$T, ff: fn(a: T): bool): []T {
    data := make_slice(cast(T)0, len(m));
    l := len(m); i := 0; c := 0;
    while i < len(m) {
        a := m[i];
        if !ff(a) { l -= 1; } else { data[c] = m[i]; c += 1; }
        i += 1;
    }
    return data[:l];
}


fn sum(data: []$T, a, b: $B): T {
    t : T = 0;
    for i in data {
        t += i;
    }
    return t;
}
fn sum2(data: ..$T): T {
    t : T = 0;
    for i in data {
        t += i;
    }
    return t;
}
fn main() {
    f(("Hello")[:], fn(i: byte): byte => i - 10);
    data := [5]f32{1.0, 1.4, 14.4, 12.5, 37.2};
    f(data[:], fn(i: f32): f32 => i - 10);
    g(1, 2);
    println("a.b:", a_dot_b(v2{1, 2}, abc{3, 4}));
    dirty := [10]f32{1.4, 2.5, -1.3, 4.4, 6.23, -4.6, -10.12, 5.3, -1.0, 7.4};
    filtered := filter(dirty[:], fn(i: f32): bool => i > 0);
    println("len filtered:", len(filtered));
    for i in filtered {
        println(i);
    }
    new(v2{1, 2});
    
    println("sum:",  sum(dirty[:], 1, 2));
    println("sum2:",  sum2(1.4, 2.5, -1.3, 4.4, 6.23, -4.6, -10.12, 5.3, -1.0, 7.4));

    generic_fn(cast(i32)1);
    generic_fn("Hello!");
    v: i32 = len(dirty);
    println(type_id(i32), type_id(v), type_id(i64), type_id(len(dirty)));

    d := len(dirty) - 1;
    println("d:", d, type_id(d));
}

fn fff() {
    xs := [3]i64{1, 2, 3};
    p := &xs[len(xs) - 1];
}
