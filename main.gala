import "core/core.gala";
import "core/map.gala";

struct Box {
    a: $K, b: $V,
}

// fn map_make(cap: i64, like_k: $K, like_v: $V, hash: fn(hk: K): u64, eq: fn(ea: K, eb: K): bool, a: Allocator = base_allocator): Map(K, V) {
fn main(): i32 {
    m := map_make(1024, "", "", hash_str, eq_str);
    map_put(&m, "a", "it's a");
    map_put(&m, "b", "it's b");
    map_put(&m, "c", "it's c");
    map_put(&m, "abc", "it's abc");

    v := "";

    println("a?", map_get(&m, "a", &v));
    println("b?", map_get(&m, "b", &v));
    println("c?", map_get(&m, "c", &v));
    println("abc?", map_get(&m, "abc", &v));
    map_remove(&m, "b");

    println("a?", map_get(&m, "a", &v));
    println("b?", map_get(&m, "b", &v));
    println("c?", map_get(&m, "c", &v));
    println("abc?", map_get(&m, "abc", &v));
    map_free(&m);

    println(size_of(Map(i32, i32)));
    println(size_of(Box(i32, f32)));
    println(size_of(Box(f64, f32)));
    println(size_of(Box{1.3, cast(i64)0}));

    return 0;
}

