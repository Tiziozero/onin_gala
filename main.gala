import "./core.gala";
import "./rl.gala";

fn draw_poly_centre(vertecies: []Vector2, centre: Vector2) {
    l := len(vertecies);
    i := 0;
    while i < l {
        DrawTriangle(
            centre,
            vertecies[i],
            vertecies[(i + 1) % l],
            Color{r=255, g=255, b=255, a=255}
        );
        /* println(i,
            vertecies[i].x, vertecies[i].y, ":",
            vertecies[(i + 1) % l].x, vertecies[(i + 1) % l].y); */
        i += 1;
    }
}
fn main() {
    r := Rectangle{x=150 + 50, y=150 + 50, w=100, h=100};
    InitWindow(500, 500, cstr("Hello from gala!."));
    SetTargetFPS(60);
    t: f32 = 0;
    v :f32 = 1.0;
    polygon := [4]Vector2{
        Vector2{x=0,y=450},
        Vector2{x=500,y=500},
        Vector2{x=450, y=250},
        Vector2{x=100, y=100},
        };
    while !WindowShouldClose() {
        if IsKeyPressed(KEY_UP) { v *= 1.2; }
        if IsKeyPressed(KEY_DOWN) { v /= 1.2; }
        dt := GetFrameTime();
        t += v*dt;
        nr := r;
        dx := 50 * sinf(t);
        dy := 50 * cosf(t);
        nr.x -= dx/2;
        nr.w += dx;
        nr.y -= dy/2;
        nr.h += dy;
        BeginDrawing();
        ClearBackground(Color{r=0, b=0, g=0, a=255});
            draw_poly_centre(polygon[0:4], Vector2{x=150,y=150});
            DrawRectangle(cast(i32)nr.x, cast(i32)nr.y, cast(i32)nr.w, cast(i32)nr.h,
                    Color{r=255, g=255, b=50,a=255});
        EndDrawing();
    }
    CloseWindow();
}
