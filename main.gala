import "./core.gala";
import "./rl.gala";
struct Abc {}
fn main() {
    InitWindow(500, 500, &("Hello from gala!.")[0]);
    SetTargetFPS(60);
    i :byte= 0;
    while !WindowShouldClose() {
        r : byte = i;
        b : byte = 255-i;
        g : byte = (i*i) % 255;
        BeginDrawing();
        ClearBackground(Color{r=r, b=b, g=g, a=255});
        EndDrawing();
        i += 1;
        i = i % 60;
    }
    CloseWindow();
}
