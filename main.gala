// ============================================================
// Control Flow Test
// Tests:
//   - functions
//   - returns
//   - if / else
//   - nested if / else
//   - while
//   - break
//   - continue
//   - nested loops
//   - arrays
//   - structs
//   - arithmetic
//   - comparisons
//   - boolean operators
//
// Note:
//   "+=" does not exist.
// ============================================================


// ------------------------------------------------------------
// Types
// ------------------------------------------------------------

struct TestData {
    value: i64,
    active: bool,
}


// ------------------------------------------------------------
// Debug helper
// ------------------------------------------------------------

extern fn printf(fmt: ^u8,..any): void;

fn print_i(n: i64): void {
    fmt_str := "%ld\n";
    fmt := cast(^u8)&fmt_str[0];
    printf(fmt, n);
    return;
}


// ------------------------------------------------------------
// Simple if / else
// Every branch returns
// ------------------------------------------------------------

fn positive_or_negative(n: i64): i64 {

    if n > 0 {
        return 1;
    } else {
        return -1;
    }
}


// ------------------------------------------------------------
// Nested if / else
// Every possible branch returns
// ------------------------------------------------------------

fn classify_number(n: i64): i64 {

    if n > 0 {

        if n > 100 {
            return 2;
        } else {
            return 1;
        }

    } else {

        if n == 0 {
            return 0;
        } else {
            return -1;
        }
    }
}


// ------------------------------------------------------------
// Boolean operators
// ------------------------------------------------------------

fn test_boolean_logic(a: bool, b: bool): i64 {

    if a && b {
        return 1;
    } else {

        if a || b {
            return 2;
        } else {
            return 0;
        }
    }
}


fn continue_test(max: i64): i64 {
    total: i64 = 0;
    i: i64 = 0;

    while i < max {

       i = i + 1;

       if i == 3 {
           continue;
       } else {

           if i == 7 {
               continue;
           } else {
               total = total + i;
           }
       }
   }

   return total;
}



// ------------------------------------------------------------
// Break
// Stops when target is reached
// ------------------------------------------------------------

fn find_number(max: i64, target: i64): i64 {

    i: i64 = 0;

    while i < max {

        if i == target {
            break;
        } else {
            i = i + 1;
        }
    }

    if i == target {
        return i;
    } else {
        return -1;
    }
}


// ------------------------------------------------------------
// Break + continue together
// ------------------------------------------------------------

fn test_break_and_continue(max: i64): i64 {

    total: i64 = 0;
    i: i64 = 0;

    while i < max {

        i = i + 1;

        if i == 3 {
            continue;
        } else {

            if i == 8 {
                break;
            } else {
                total = total + i;
            }
        }
    }

    return total;
}


// ------------------------------------------------------------
// Nested loops
// Break only exits the inner loop
// ------------------------------------------------------------

fn nested_break_test(size: i64): i64 {

    total: i64 = 0;

    x: i64 = 0;

    while x < size {

        y: i64 = 0;

        while y < size {

            if y == 2 {
                break;
            } else {
                total = total + 1;
            }

            y = y + 1;
        }

        x = x + 1;
    }

    return total;
}


// ------------------------------------------------------------
// Nested loops with continue
// ------------------------------------------------------------

fn nested_continue_test(size: i64): i64 {

    total: i64 = 0;

    x: i64 = 0;

    while x < size {

        y: i64 = 0;

        while y < size {

            y = y + 1;

            if y == 2 {
                continue;
            } else {
                total = total + 1;
            }
        }

        x = x + 1;
    }

    return total;
}


// ------------------------------------------------------------
// Arrays
// ------------------------------------------------------------

fn array_test(): i64 {

    values := [5]i64{ };
    
    values[0] = 10;
    values[1] = 20;
    values[2] = 30;
    values[3] = 40;
    values[4] = 50;
    total: i64 = 0;
    i: i64 = 0;

    while i < 5 {

        if values[i] > 25 {
            total = total + values[i];
        } else {
            total = total - values[i];
        }

        i = i + 1;
    }

    return total;
}


// ------------------------------------------------------------
// Structs
// ------------------------------------------------------------

fn struct_test(): i64 {

    data := TestData{
        value = 10,
        active = true,
    };

    if data.active {

        if data.value > 5 {
            return data.value;
        } else {
            return -1;
        }

    } else {
        return 0;
    }
}


// ------------------------------------------------------------
// Array of structs
// ------------------------------------------------------------

fn struct_array_test(): i64 {

    data := [3]TestData{};

    data[0].value = 10;
    data[0].active = true;

    data[1].value = 20;
    data[1].active = false;

    data[2].value = 30;
    data[2].active = true;

    total: i64 = 0;
    i: i64 = 0;

    while i < 3 {

        if !data[i].active {
            i = i + 1;
            continue;
        } else {
            total = total + data[i].value;
        }

        i = i + 1;
    }

    return total;
}


// ------------------------------------------------------------
// Multiple comparisons
// ------------------------------------------------------------

fn comparison_test(a: i64, b: i64): i64 {

    if a == b {
        return 0;
    } else {

        if a > b {
            return 1;
        } else {

            if a < b {
                return -1;
            } else {
                return 99;
            }
        }
    }
}


// ------------------------------------------------------------
// Main test
// ------------------------------------------------------------

fn main(): i64 {

    a := positive_or_negative(10);
    print_i(a);                      // expect 1
    b := positive_or_negative(-10);
    print_i(b);                      // expect -1

    c := classify_number(200);
    print_i(c);                      // expect 2
    d := classify_number(50);
    print_i(d);                      // expect 1
    e := classify_number(0);
    print_i(e);                      // expect 0
    f := classify_number(-10);
    print_i(f);                      // expect -1

    g := test_boolean_logic(true, true);
    print_i(g);                      // expect 1
    h := test_boolean_logic(true, false);
    print_i(h);                      // expect 2
    i := test_boolean_logic(false, false);
    print_i(i);                      // expect 0

    odd_sum := continue_test(10);
    print_i(odd_sum);                // expect 45

    found := find_number(10, 5);
    print_i(found);                  // expect 5
    not_found := find_number(5, 20);
    print_i(not_found);              // expect -1

    break_continue := test_break_and_continue(20);
    print_i(break_continue);         // expect 25

    nested_break := nested_break_test(5);
    print_i(nested_break);           // expect 10
    nested_continue := nested_continue_test(5);
    print_i(nested_continue);        // expect 20

    array_result := array_test();
    print_i(array_result);           // expect 90
    struct_result := struct_test();
    print_i(struct_result);          // expect 10
    struct_array_result := struct_array_test();
    print_i(struct_array_result);    // expect 40

    comparison_a := comparison_test(10, 10);
    print_i(comparison_a);           // expect 0
    comparison_b := comparison_test(20, 10);
    print_i(comparison_b);           // expect 1
    comparison_c := comparison_test(10, 20);
    print_i(comparison_c);           // expect -1

    // Use all results so assignments / variables
    // are exercised by the test.

    total: i64 = 0;

    total = total + a;
    total = total + b;

    total = total + c;
    total = total + d;
    total = total + e;
    total = total + f;

    total = total + g;
    total = total + h;
    total = total + i;

    total = total + odd_sum;

    total = total + found;
    total = total + not_found;

    total = total + break_continue;

    total = total + nested_break;
    total = total + nested_continue;

    total = total + array_result;
    total = total + struct_result;
    total = total + struct_array_result;

    total = total + comparison_a;
    total = total + comparison_b;
    total = total + comparison_c;

    print_i(total);                  // expect 249

    rs := "ret: %ld\n";
    fmt := cast(^u8)&rs[0];
    printf(fmt, total + 16);
    return total + 16;
}
