import "./core.gala";
fn on_slice(data: []i32, f: fn(i: i32): i32) {
    i := 0;
    while i < len(data) {
        data[i] = f(data[i]);
        i+=1;
    }
}
fn print_slice(data: []i32, b: i32= 2) {
    i := 0;
    for n in data {
        printf(&("value %d is %d\n")[0], i, n); i += 1;
    }
    printf(&("b: %d\n")[0], b);
}
fn a(data: ..any) {
    i := 0;
    for n in data {
        printf(&("value %d is %s\n")[0], i, 0); i += 1;
    }
}
fn main() {
    a("Hello", ", ", "World!");
    printf(&("len of \"Hello\": %d\n")[0], len("Hello"));
    data := [1024]i32{1, 2, 3};
    println("Hello", "World", 1, 2, 3, a, data[0:2]);
    print_slice(data[0:5]);
    on_slice(data[0:5], fn(i: i32): i32 => i * 4);
    print_slice(data[0:5], 1234);


    i := 0;
    while i < 10 * 4 * 2 {
        n := [1024]byte{};
        snprintf(&n[0], 1024,  &(".gala_build/a_%d.b")[0], i + 160 * 2 + 40);
        printf(&n[0]);
        printf(&("\n")[0]);
        f := fopen(&(n)[0], &("w")[0]);
        if f != 0 {
            j := 0;
            while j <= 1024*128*128/8 {
                fprintf(f, &("value = %d\n")[0], 42);
                fprintf(f, &("pi = %f\n")[0], 3.14159);
                j += 1;
            }
            fclose(f);
        }
        i += 1;
    }
}
