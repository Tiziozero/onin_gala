fn a(data: ..any) {
    i := 0;
    for n in data {
        printf(&("value %d is %s\n")[0], i, 0); i += 1;
    }
}
fn main() {
    a("Hello", ", ", "World!");
    printf(&("len of \"Hello\": %d\n")[0], len("Hello"));
    data := [1024]{1, 2, 3};
    println("Hello", "World", 1, 2, 3, a);
}
