import "./core.gala";
import "./net.gala";

fn main() {
    server := tcp_listen(9000, 16);

    if server.fd < 0 {
        println("failed to start server");
        return;
    }

    println("echo server listening on port 9000");

    while true {
        client := tcp_accept(server);

        if client.fd < 0 {
            println("accept failed");
            continue;
        }

        println("client connected");

        buffer:=[1024]byte{};

        while true {
            n := tcp_recv(
                client,
                &buffer[0],
                1024,
            );

            if n <= 0 {
                break;
            }

            tcp_send(
                client,
                &buffer[0],
                cast(u64)n,
            );
        }

        println("client disconnected");

        tcp_close(client);
    }

    tcp_close(server);
}
