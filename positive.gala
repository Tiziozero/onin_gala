extern fn printf(fmt: ^byte, data: ..any);
extern fn call_i32(f: fn(l: i32, r: i32): i32, x: i32, y: i32): i32;
extern fn call_f64(f: fn(v: f64): f64, x: f64): f64;
extern fn call_nested(f: fn(g: fn(): i32): i32): i32;
extern fn get_adder(): fn(l: i32, r: i32): i32;

struct Ops {
    op: fn(l: i32, r: i32): i32,
    bias: i32,
}

fn expect(id: i32, got: i32, want: i32) {
    if got == want {
        printf(&("ok   %d\n")[0], id);
    } else {
        printf(&("FAIL %d: got %d, want %d\n")[0], id, got, want);
    }
}

fn add(l: i32, r: i32): i32 { return l + r; }
fn sub(l: i32, r: i32): i32 { return l - r; }
fn twice(v: f64): f64 { return v * 2.0; }
fn seven(): i32 { return 7; }

// fn taking a fn (nested fn type)
fn plus_one(g: fn(): i32): i32 { return g() + 1; }

// gala fn taking a fn plus normal args
fn apply(f: fn(l: i32, r: i32): i32, x: i32, y: i32): i32 {
    return f(x, y);
}

// fn returning a fn
fn pick(flag: i32): fn(l: i32, r: i32): i32 {
    if flag == 0 { return add; }
    return sub;
}

fn main() {
    // 1-2: gala fns passed to an extern C fn (id differs from the extern
    // param's type id, so this goes through structural type_cmp)
    expect(1, call_i32(add, 3, 4), 7);
    expect(2, call_i32(sub, 10, 4), 6);

    // 3-4: local fn variable, call it, reassign it
    f : fn(l: i32, r: i32): i32 = add;
    expect(3, f(20, 22), 42);
    f = sub;
    expect(4, f(20, 22), -2);

    // 5: gala fn with a fn-typed parameter
    expect(5, apply(add, 1, 2), 3);

    // 6: f64 through an extern fn pointer call
    expect(6, cast(i32)call_f64(twice, 2.25), 4);

    // 7-8: nested fn types, C side and gala side
    expect(7, call_nested(plus_one), 8);
    expect(8, plus_one(seven), 8);

    // 9-10: fn returning fn, stored in locals with inferred type
    g1 := pick(0);
    g2 := pick(1);
    expect(9, g1(9, 4), 13);
    expect(10, g2(9, 4), 5);

    // 11: fn returned by an extern
    k := get_adder();
    expect(11, k(100, 23), 123);

    // 12-13: fn pointer in a struct field
    o := Ops{op = add, bias = 10};
    expect(12, o.op(1, 2) + o.bias, 13);
    expect(13, call_i32(o.op, 6, 7), 13);

    // 14: local fn var (currently sub) passed to an extern
    expect(14, call_i32(f, 50, 8), 42);

    // 15: fn var called inside a loop
    acc : i32 = 0;
    i : i32 = 0;
    while i < 5 {
        acc = apply(add, acc, i);
        i += 1;
    }
    expect(15, acc, 10);

    // 16: assign an extern-returned fn to a local declared with a spec
    f = k;
    expect(16, f(30, 12), 42);

    return;
}

