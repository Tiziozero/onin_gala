// Writes with typed access, reads back raw bytes: proves where fields
// and elements really live.
fn test_layout_bytes() {
    section("raw memory layout");

    p2 := Pad2{a = 1, b = 258, c = 3,};
    raw := cast(^byte)&p2;
    eq_i32("Pad2.a at offset 0", cast(i32)raw[0], 1);
    eq_i32("Pad2.b low byte at offset 2", cast(i32)raw[2], 2);
    eq_i32("Pad2.b high byte at offset 3", cast(i32)raw[3], 1);
    eq_i32("Pad2.c at offset 4", cast(i32)raw[4], 3);

    padded_ := Padded{a = 9, b = 16909060, c = 5,};
    rawp := cast(^byte)&padded_;
    eq_i32("Padded.a at offset 0", cast(i32)rawp[0], 9);
    eq_i32("Padded.b low byte at offset 4", cast(i32)rawp[4], 4);
    eq_i32("Padded.b high byte at offset 7", cast(i32)rawp[7], 1);
    eq_i32("Padded.c at offset 8", cast(i32)rawp[8], 5);

    // element stride of an array of 6-byte structs is 6
    arr := [3]Pad2{};
    arr[1].a = 1;
    arr[1].b = 258;
    arr[2].c = 5;
    rawa := cast(^byte)&arr[0];
    eq_i32("stride: arr[1].a at 6", cast(i32)rawa[6], 1);
    eq_i32("stride: arr[1].b low at 8", cast(i32)rawa[8], 2);
    eq_i32("stride: arr[2].c at 16", cast(i32)rawa[16], 5);

    // nested struct offsets
    s := Seg{a = Vec2{x = 1.0, y = 2.0,}, b = Vec2{x = 3.0, y = 4.0,},};
    fp := cast(^f32)&s;
    approx32("Seg raw [0]", fp[0], 1.0);
    approx32("Seg raw [3]", fp[3], 4.0);
}

fn test_small_structs_abi() {
    section("small structs: register classes");

    // ---- all SSE ----
    v4 := vec4_add(Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0,}, Vec4{x = 0.5, y = 0.5, z = 0.5, w = 0.5,});
    approx32("Vec4 x", v4.x, 1.5);
    approx32("Vec4 y", v4.y, 2.5);
    approx32("Vec4 z", v4.z, 3.5);
    approx32("Vec4 w", v4.w, 4.5);

    ones := Vec4{x = 1.0, y = 1.0, z = 1.0, w = 1.0,};
    a4 := Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0,};
    r4 := vec4_add(vec4_add(a4, ones), vec4_add(a4, a4));
    approx32("Vec4 chained y", r4.y, 7.0);
    approx32("Vec4 chained w", r4.w, 13.0);

    d2 := dbl2_swap(Dbl2{a = 1.5, b = 2.5,});
    approx("Dbl2 swap a", d2.a, 2.5);
    approx("Dbl2 swap b", d2.b, 1.5);

    // ---- all integer ----
    eq_i32("Pt2i sum", pt_sum(Pt2i{x = 3, y = 4,}), 7);
    sw := pt_swap(Pt2i{x = 3, y = 4,});
    eq_i32("Pt2i swap x", sw.x, 4);
    eq_i32("Pt2i swap y", sw.y, 3);

    t3 := tri32_make(1, 2, 3);
    eq_i32("Tri32 fields", t3.a * 100 + t3.b * 10 + t3.c, 123);
    eq_i32("Tri32 sum", tri32_sum(t3), 6);
    eq_i32("Tri32 rvalue", tri32_sum(tri32_make(10, 20, 30)), 60);

    // ---- sub-word sizes (3-byte structs etc: coercion suspects) ----
    b3 := byte3_make(10, 20, 30);
    eq_i32("Byte3 a", cast(i32)b3.a, 10);
    eq_i32("Byte3 b", cast(i32)b3.b, 20);
    eq_i32("Byte3 c", cast(i32)b3.c, 30);
    eq_i32("Byte3 sum", byte3_sum(b3), 60);
    eq_i32("Byte3 rvalue", byte3_sum(byte3_make(1, 2, 3)), 6);

    b8 := bytes8_make(1);
    eq_i32("Bytes8 b0", cast(i32)b8.b0, 1);
    eq_i32("Bytes8 b7", cast(i32)b8.b7, 8);
    eq_i32("Bytes8 sum", bytes8_sum(b8), 36);

    fl := flags_make(true, false, 9);
    check("Flags a", fl.a);
    check("Flags b", !fl.b);
    eq_i32("Flags n", cast(i32)fl.n, 9);
    fl2 := flags_flip(fl);
    check("Flags flipped a", !fl2.a);
    check("Flags flipped b", fl2.b);
    eq_i32("Flags flipped n", cast(i32)fl2.n, 10);

    eq_i32("one-field i32", one_i_inc(OneI{v = 5,}).v, 6);
    approx("one-field f64", one_d_twice(OneD{v = 2.5,}).v, 5.0);
    eq_i32("one-field byte", cast(i32)one_b_next(OneB{v = 41,}).v, 42);

    z16 : i16 = 0;
    m5 := z16 - 5;
    sh := shorts_make(100, 60000, m5, 65535);
    eq_i32("Shorts a", cast(i32)sh.a, 100);
    eq_i32("Shorts b", cast(i32)sh.b, 60000);
    eq_i32("Shorts c", cast(i32)sh.c + 5, 0);
    eq_i32("Shorts d", cast(i32)sh.d, 65535);
    eq_i32("Shorts sum", shorts_sum(sh), 125630);

    // ---- mixed integer/float eightbytes ----
    mfi := mix_fi_make(1.5, 7);
    approx32("MixFI f", mfi.f, 3.0);
    eq_i32("MixFI n", mfi.n, 8);
    approx("MixFI sum", mix_fi_sum(mfi), 11.0);

    mdi := mix_di_make(2.5, 9);
    approx("MixDI d", mdi.d, 5.0);
    eq_i32("MixDI n", mdi.n, 10);
    approx("MixDI sum", mix_di_sum(mdi), 15.0);

    mid := mix_id_make(3, 0.5);
    eq_i32("MixID n", mid.n, 4);
    approx("MixID d", mid.d, 1.0);
    approx("MixID sum", mix_id_sum(mid), 5.0);

    mbd := mix_bd_make(200, 1.5);
    eq_i32("MixBD b", cast(i32)mbd.b, 201);
    approx("MixBD d", mbd.d, 2.5);
    approx("MixBD sum", mix_bd_sum(mbd), 203.5);

    mlf := mix_lf_make(5000000000, 2.0);
    eq_i64("MixLF n", mlf.n, 5000000001);
    approx32("MixLF f", mlf.f, 6.0);
    approx("MixLF sum", mix_lf_sum(mlf), 5000000007.0);

    mfl := mix_fl_make(1.5, 5000000000);
    approx32("MixFL f", mfl.f, 2.5);
    eq_i64("MixFL n", mfl.n, 10000000000);
    approx("MixFL sum", mix_fl_sum(mfl), 10000000002.5);

    approx("MixDI from a call result", mix_di_sum(mix_di_make(2.5, 9)), 15.0);
    eq_i32("field of a MixDI call result", mix_di_make(2.5, 9).n, 10);

    // ---- padding ----
    p2 := pad2_make(7, 1000, 9);
    eq_i32("Pad2 a", cast(i32)p2.a, 7);
    eq_i32("Pad2 b", cast(i32)p2.b, 1000);
    eq_i32("Pad2 c", cast(i32)p2.c, 9);
    eq_i32("Pad2 sum", pad2_sum(p2), 1016);
    eq_i32("Pad2 from a call", pad2_sum(pad2_make(1, 2, 3)), 6);

    p3 := pad3_make(3, 5000000000);
    eq_i32("Pad3 a", cast(i32)p3.a, 3);
    eq_i64("Pad3 b", p3.b, 5000000000);

    p4 := pad4_make(5000000000, 9);
    eq_i64("Pad4 a", p4.a, 5000000000);
    eq_i32("Pad4 b", cast(i32)p4.b, 9);

    p5 := pad5_make(2.5, 7);
    approx32("Pad5 f", p5.f, 2.5);
    eq_i32("Pad5 b", cast(i32)p5.b, 7);

    pdd := padded_make(1, 1000000, 2);
    eq_i32("Padded a", cast(i32)pdd.a, 1);
    eq_i32("Padded b", pdd.b, 1000000);
    eq_i32("Padded c", cast(i32)pdd.c, 2);

    // ---- arrays inside small structs ----
    ar := arr2_make(3, 4);
    eq_i32("Arr2 sum", arr2_sum(ar), 7);
    eq_i32("Arr2 element", ar.v[1], 4);

    af := arrf4_scale(ArrF4{v = [4]f32{1.0, 2.0, 3.0, 4.0}}, 0.5);
    approx32("ArrF4 [0]", af.v[0], 0.5);
    approx32("ArrF4 [3]", af.v[3], 2.0);

    a16 := arr16_make(1);
    eq_i32("Arr16 sum", arr16_sum(a16), 136);
    eq_i32("Arr16 last", cast(i32)a16.v[15], 16);

    // ---- pointer member ----
    x : i32 = 33;
    pb := ptrbox_make(&x, 4);
    q := pb.p;
    eq_i32("PtrBox pointer read", q^, 33);
    q^ = 44;
    eq_i32("PtrBox pointer write", x, 44);
    eq_i32("PtrBox other field", pb.n, 4);
}

fn test_small_struct_semantics() {
    section("small structs: value semantics");

    a := Pt2i{x = 1, y = 2,};
    b := a;
    b.x = 100;
    eq_i32("copy independent", a.x, 1);
    eq_i32("copy has the new value", b.x, 100);

    a.x += 5;
    a.y += 5;
    eq_i32("field +=", a.x * 10 + a.y, 67);

    pt_scale_ptr(&a, 3);
    eq_i32("modify through pointer", a.x + a.y, 39);

    q := Pt2i{x = 40, y = 50,};
    swap_pts(&a, &q);
    eq_i32("swap a.x", a.x, 40);
    eq_i32("swap a.y", a.y, 50);
    eq_i32("swap q.x", q.x, 18);
    eq_i32("swap q.y", q.y, 21);

    py := &a.y;
    py^ = 77;
    eq_i32("write through pointer to a field", a.y, 77);
    eq_i32("read through pointer to a field", py^, 77);

    // ---- nested ----
    s := seg_make(1.0, 2.0, 3.0, 4.0);
    t := s;
    t.a.x = 99.0;
    approx32("nested copy independent", s.a.x, 1.0);
    approx32("nested copy has the new value", t.a.x, 99.0);
    s.b.y = 8.5;
    approx32("nested write", s.b.y, 8.5);
    approx("Seg sum", seg_sum(s), 14.5);
    s.a = s.b;
    approx32("assign a nested struct member x", s.a.x, 3.0);
    approx32("assign a nested struct member y", s.a.y, 8.5);

    // ---- arrays of small structs ----
    ps := [4]Pad2{};
    k := 0;
    while k < 4 {
        ps[k].a = cast(byte)(k + 1);
        ps[k].b = cast(i16)(k * 1000);
        ps[k].c = cast(byte)(k + 10);
        k += 1;
    }
    tot : i32 = 0;
    for p in ps {
        tot += pad2_sum(p);
    }
    eq_i32("for over an array of Pad2", tot, 6056);
    eq_i32("array of Pad2 by value", sum_pad2_arr(ps), 6056);

    segs := [2]Seg{seg_make(1.0, 2.0, 3.0, 4.0), seg_make(5.0, 6.0, 7.0, 8.0)};
    approx32("segs[1].b.y", segs[1].b.y, 8.0);
    segs[0] = segs[1];
    approx32("segs[0] = segs[1]", segs[0].a.x, 5.0);
    segs[1].a.x = 50.0;
    approx32("elements are independent", segs[0].a.x, 5.0);

    // ---- calls in a loop ----
    tt : i32 = 0;
    k = 0;
    while k < 10 {
        tt += pt_sum(pt_make(cast(i32)k, 1));
        k += 1;
    }
    eq_i32("small struct calls in a loop", tt, 55);

    // ---- strings inside structs ----
    r := rec_make(5, 2.5, "hello", true);
    eq_i32("Rec id", r.id, 5);
    approx("Rec score", r.score, 2.5);
    eq_i64("Rec name length", cast(i64)len(r.name), 5);
    check("Rec flag", r.flag);
    eq_i32("Rec name[1]", cast(i32)r.name[1], 101);
    r2 := r;
    r2.id = 9;
    eq_i32("Rec copy independent", r.id, 5);
    eq_i64("Rec through two calls", rec_weight(rec_pass(r)), 10);

    recs := [3]Rec{rec_make(1, 0.5, "a", true), rec_make(2, 1.5, "bb", false), rec_make(3, 2.5, "ccc", true)};
    ids : i32 = 0;
    lens : i64 = 0;
    scores : f64 = 0.0;
    nflags : i32 = 0;
    for rc in recs {
        ids += rc.id;
        lens += cast(i64)len(rc.name);
        scores += rc.score;

        if rc.flag {
            nflags += 1;
        }
    }
    eq_i32("for over Rec: ids", ids, 6);
    eq_i64("for over Rec: name lengths", lens, 6);
    approx("for over Rec: scores", scores, 4.5);
    eq_i32("for over Rec: flags", nflags, 2);
}

fn test_many_args() {
    section("argument passing under register pressure");

    s := many_vec2(Vec2{x = 1.0, y = 2.0,}, Vec2{x = 3.0, y = 4.0,}, Vec2{x = 5.0, y = 6.0,},
                   Vec2{x = 7.0, y = 8.0,}, Vec2{x = 9.0, y = 10.0,}, Vec2{x = 11.0, y = 12.0,},
                   Vec2{x = 13.0, y = 14.0,}, Vec2{x = 15.0, y = 16.0,}, Vec2{x = 17.0, y = 18.0,},
                   Vec2{x = 19.0, y = 20.0,});
    approx("10 Vec2 args (SSE regs, then stack)", s, 210.0);

    eq_i32("9 Pt2i args (int regs, then stack)",
        many_pt(pt_make(1, 2), pt_make(3, 4), pt_make(5, 6), pt_make(7, 8), pt_make(9, 10),
                pt_make(11, 12), pt_make(13, 14), pt_make(15, 16), pt_make(17, 18)), 171);

    eq_i64("memory structs interleaved with an int",
        many_mem(tri_make(1, 2, 3), tri_make(4, 5, 6), tri_make(7, 8, 9), 100, tri_make(10, 11, 12)), 178);

    sr := sret_with_regs(1, 2, 3, 4, 5, 6, 7);
    eq_i64("sret + 7 int args: a", sr.a, 8);
    eq_i64("sret + 7 int args: b", sr.b, 8);
    eq_i64("sret + 7 int args: c", sr.c, 12);

    approx("struct soup",
        mixed_structs(1, Pt2i{x = 2, y = 3,}, 4.5, Vec2{x = 5.0, y = 6.0,},
                      Quad{a = 7, b = 8, c = 9, d = 10,}, "abc", rec_make(11, 0.25, "xy", true), 12),
        81.75);

    approx("big structs between scalars",
        big_between(1, make_big(3, 0), 2, make_big(0, 4), 0.5), 10.5);
}

fn test_medium_structs() {
    section("medium structs (17..64 bytes)");

    q := quad_make(10);
    eq_i64("Quad a", q.a, 10);
    eq_i64("Quad d", q.d, 13);
    eq_i64("Quad sum", quad_sum(q), 46);
    q2 := q;
    q2.a = 0;
    eq_i64("Quad copy independent", q.a, 10);
    eq_i64("Quad from a call result", quad_sum(quad_make(1)), 10);

    v1 := Vec3d{x = 1.0, y = 2.0, z = 3.0,};
    v2 := Vec3d{x = 4.0, y = 5.0, z = 6.0,};
    approx("Vec3d dot", vec3d_dot(v1, v2), 32.0);
    cr := vec3d_cross(v1, v2);
    approx("cross x", cr.x, 0.0 - 3.0);
    approx("cross y", cr.y, 6.0);
    approx("cross z", cr.z, 0.0 - 3.0);
    approx("cross is perpendicular", vec3d_dot(vec3d_cross(v1, v2), v1), 0.0);

    a := Mat2{m = [4]f64{1.0, 2.0, 3.0, 4.0}};
    b := Mat2{m = [4]f64{5.0, 6.0, 7.0, 8.0}};
    c := mat2_mul(a, b);
    approx("Mat2 mul [0]", c.m[0], 19.0);
    approx("Mat2 mul [1]", c.m[1], 22.0);
    approx("Mat2 mul [2]", c.m[2], 43.0);
    approx("Mat2 mul [3]", c.m[3], 50.0);
    approx("Mat2 trace", mat2_trace(c), 69.0);
    c2 := mat2_mul(c, mat2_identity());
    approx("Mat2 times identity", c2.m[3], 50.0);

    m40 := med40_make(10);
    eq_i32("Med40 a", m40.a, 10);
    eq_i32("Med40 last", m40.arr[8], 18);
    eq_i32("Med40 sum", med40_sum(m40), 136);

    m4 := mat4f_scale(mat4f_identity(), 2.5);
    approx32("Mat4f trace", mat4f_trace(m4), 10.0);
    approx32("Mat4f off-diagonal", m4.m[1], 0.0);

    m17 := med17_make(1);
    eq_i32("Med17 sum", med17_sum(m17), 153);
    eq_i32("Med17 last", cast(i32)m17.v[16], 17);

    t := tri_make(1, 2, 3);
    t = tri_rot(t);
    eq_i64("tri_rot a", t.a, 2);
    eq_i64("tri_rot b", t.b, 3);
    eq_i64("tri_rot c", t.c, 1);
    t = tri_rot(tri_rot(t));
    eq_i64("three rotations: a", t.a, 1);
    eq_i64("three rotations: b", t.b, 2);
    eq_i64("three rotations: c", t.c, 3);

    ws := [2]Wide{wide_make(1), wide_make(100)};
    eq_i64("array of Wide: e", ws[0].e, 5);
    eq_i64("array of Wide: sum", wide_sum(ws[1]), 510);

    ns := Named{name = "bob", id = 7,};
    eq_i64("Named by value", named_len(ns), 21);
}

fn test_size_boundary() {
    section("sizes around the 64-byte memory-type threshold");

    eq_i32("Sz60 sum", sz60_sum(sz60_make(1)), 120);
    eq_i32("Sz64 sum", sz64_sum(sz64_make(1)), 136);
    eq_i32("Sz68 sum", sz68_sum(sz68_make(1)), 153);
    eq_i64("Sz72 sum", sz72_sum(sz72_make(1)), 45);

    eq_i32("Sz64 pass-through", sz64_sum(sz64_pass(sz64_make(2))), 152);
    eq_i32("Sz68 pass-through", sz68_sum(sz68_pass(sz68_make(2))), 170);

    a := sz68_make(1);
    b := a;
    b.v[0] = 100;
    eq_i32("Sz68 copy independent", a.v[0], 1);
    eq_i32("Sz68 copy has the new value", b.v[0], 100);

    c := sz64_make(1);
    d := c;
    d.v[15] = 500;
    eq_i32("Sz64 copy independent", c.v[15], 16);
    eq_i32("Sz64 copy has the new value", d.v[15], 500);

    e := sz72_make(1);
    f := e;
    f.v[8] = 1;
    eq_i64("Sz72 copy independent", e.v[8], 9);

    x := sz64_make(1);
    x = sz64_pass(x);
    eq_i32("Sz64 assign result onto its own argument", sz64_sum(x), 136);

    y := sz68_make(1);
    y = sz68_pass(y);
    eq_i32("Sz68 assign result onto its own argument", sz68_sum(y), 153);
}

fn test_big_structs_more() {
    section("large structs (more)");

    // ---- Grid ----
    g := grid_make(8, 8);
    eq_i32("Grid sum", grid_sum(g), 2016);
    eq_i32("Grid w * h", g.w * g.h, 64);
    g2 := g;
    g2.cells[10] = 1000;
    eq_i32("Grid copy independent", g.cells[10], 10);
    eq_i32("Grid from a call result", grid_sum(grid_make(2, 2)), 2016);

    // ---- Huge (40 KB) ----
    h := huge_make(6);
    eq_i64("Huge sum", huge_sum(h), 30000);
    h2 := h;
    h2.data[0] = 1000;
    eq_i64("Huge copy independent", cast(i64)h.data[0], 0);
    eq_i64("Huge from a call result", huge_sum(huge_make(6)), 30000);

    // ---- a struct of two big structs ----
    bp := bigpair_make(1);
    eq_i32("BigPair a.a", bp.a.a, 1);
    eq_i32("BigPair b.a", bp.b.a, 2);
    eq_i32("BigPair a.data", bp.a.data[999], 2);
    eq_i32("BigPair b.data", bp.b.data[999], 4);
    eq_i32("BigPair sum", bigpair_sum(bp), 12);
    bp2 := bp;
    bp2.b.data[999] = 0;
    eq_i32("BigPair copy independent", bp.b.data[999], 4);
    eq_i32("BigPair from a call", bigpair_sum(bigpair_make(1)), 12);

    // ---- big struct with a float, string, i16 array and bool ----
    bm := bm_make();
    approx("BigMixed f", bm.f, 2.5);
    eq_i64("BigMixed name length", cast(i64)len(bm.name), 3);
    eq_i32("BigMixed data[199]", cast(i32)bm.data[199], 123);
    eq_i32("BigMixed data[0]", cast(i32)bm.data[0], 7);
    check("BigMixed flag", bm.flag);
    eq_i32("BigMixed by value", bm_check(bm), 1126);
    bm2 := bm;
    bm2.flag = false;
    check("BigMixed copy independent", bm.flag);
    eq_i32("BigMixed copy has the new value", bm_check(bm2), 126);
    eq_i32("BigMixed from a call", bm_check(bm_make()), 1126);

    // ---- swap through pointers ----
    x := make_big(1, 2);
    y := make_big(3, 4);
    swap_bigs(&x, &y);
    eq_i32("swap: x.a", x.a, 3);
    eq_i32("swap: x.data", x.data[999], 7);
    eq_i32("swap: y.a", y.a, 1);
    eq_i32("swap: y.data", y.data[999], 3);

    // ---- control flow returning big structs ----
    eq_i32("pick_big true", pick_big(true, make_big(1, 2), make_big(3, 4)).a, 1);
    eq_i32("pick_big false", pick_big(false, make_big(1, 2), make_big(3, 4)).a, 3);

    // ---- chains ----
    eq_i32("chained big calls", big_checksum(big_passthrough(make_big(1, 2))), 6);
    eq_i32("two sret results in one expression",
        big_checksum(make_big(1, 1)) + big_checksum(make_big(2, 2)), 12);
    eq_i32("deep field of a call result", make_big(3, 4).data[999], 7);

    // ---- sort an array of big structs through a pointer ----
    ba := [3]Big{make_big(3, 0), make_big(1, 0), make_big(2, 0)};
    sort_bigs(&ba[0], 3);
    eq_i32("sorted bigs [0]", ba[0].a, 1);
    eq_i32("sorted bigs [1]", ba[1].a, 2);
    eq_i32("sorted bigs [2]", ba[2].a, 3);
    eq_i32("payload followed the sort [0]", ba[0].data[999], 1);
    eq_i32("payload followed the sort [2]", ba[2].data[999], 3);

    // ---- arrays of big structs, returned by value ----
    b3 := make_bigs3();
    eq_i32("returned [3]Big: [2].b", b3[2].b, 3);
    eq_i32("returned [3]Big: [0].data", b3[0].data[999], 2);

    // ---- nested ----
    wr := Wrapper{id = 9, payload = make_big(5, 6)};
    eq_i32("Wrapper id", wr.id, 9);
    eq_i32("Wrapper payload", wr.payload.data[999], 11);
    wr2 := wr;
    wr2.payload.a = 1000;
    eq_i32("Wrapper copy independent", wr.payload.a, 5);

    // ---- padding must survive copies ----
    bpd := make_bigpad();
    bpd2 := bpd;
    eq_i32("BigPad c", cast(i32)bpd2.c, 7);
    eq_i32("BigPad data", bpd2.data[19], 19);
    eq_i64("BigPad b", bpd2.b, 2);

    // ---- pointers into a big struct ----
    z := make_big(0, 0);
    pz := &z.data[500];
    pz^ = 9;
    eq_i32("pointer to an element inside a big struct", z.data[500], 9);
}

fn test_arrays_more() {
    section("arrays (more)");

    // ---- sieve over a bool array ----
    sieve := [100]bool{};
    count : i32 = 0;
    i := 2;
    while i < 100 {
        if !sieve[i] {
            count += 1;
            j := i * 2;

            while j < 100 {
                sieve[j] = true;
                j += i;
            }
        }

        i += 1;
    }
    eq_i32("primes below 100 (bool array)", count, 25);

    // ---- 3x3 matrices, by value in and out ----
    a3 := mat3_make();
    eq_i32("mat3 [0][0]", a3[0][0], 1);
    eq_i32("mat3 [2][2]", a3[2][2], 9);
    eq_i32("mat3 trace", mat3_trace(a3), 15);

    c3 := mat3_mul(a3, a3);
    eq_i32("mat3 mul [0][2]", c3[0][2], 42);
    eq_i32("mat3 mul [1][1]", c3[1][1], 81);
    eq_i32("mat3 mul [2][0]", c3[2][0], 102);
    eq_i32("mat3 mul trace", mat3_trace(c3), 261);

    t3 := mat3_transpose(a3);
    eq_i32("transpose [0][2]", t3[0][2], 7);
    eq_i32("transpose [2][0]", t3[2][0], 3);
    eq_i32("original untouched by transpose", a3[0][2], 3);

    eq_i32("row_sum 2", row_sum(a3, 2), 24);
    eq_i32("row_sum 0", row_sum(a3, 0), 6);
    eq_i32("find_in hit", find_in(a3, 6), 12);
    eq_i32("find_in first", find_in(a3, 1), 0);
    eq_i32("find_in miss", find_in(a3, 10), 99);

    b3 := a3;
    b3[1][1] = 100;
    eq_i32("2D copy independent", a3[1][1], 5);
    eq_i32("2D copy has the new value", b3[1][1], 100);

    // ---- 3D ----
    cube := [2][3][4]i32{};
    x3 := 0;
    while x3 < 2 {
        y3 := 0;

        while y3 < 3 {
            z3 := 0;

            while z3 < 4 {
                cube[x3][y3][z3] = cast(i32)(x3 * 100 + y3 * 10 + z3);
                z3 += 1;
            }

            y3 += 1;
        }

        x3 += 1;
    }
    eq_i32("3D [0][0][0]", cube[0][0][0], 0);
    eq_i32("3D [1][2][3]", cube[1][2][3], 123);
    eq_i32("3D [1][0][1]", cube[1][0][1], 101);
    eq_i32("3D [0][2][2]", cube[0][2][2], 22);

    // ---- other element types ----
    bs := [4]byte{250, 251, 252, 253};
    bsum : i32 = 0;
    for bv in bs {
        bsum += cast(i32)bv;
    }
    eq_i32("byte array sum", bsum, 1006);

    fs := [4]f32{0.5, 1.5, 2.5, 3.5};
    fsum : f32 = 0.0;
    for fv in fs {
        fsum += fv;
    }
    approx32("f32 array sum", fsum, 8.0);

    ds := [3]f64{1.25, 2.5, 5.0};
    dsum : f64 = 0.0;
    for dv in ds {
        dsum += dv;
    }
    approx("f64 array sum", dsum, 8.75);

    ls := [3]i64{5000000000, 6000000000, 7000000000};
    lsum : i64 = 0;
    for lv in ls {
        lsum += lv;
    }
    eq_i64("i64 array sum", lsum, 18000000000);
    eq_i64("len of an i64 array", cast(i64)len(ls), 3);

    shs := [3]i16{30000, 10000, 5};
    ssum : i32 = 0;
    for sv in shs {
        ssum += cast(i32)sv;
    }
    eq_i32("i16 array sum", ssum, 40005);

    ia := [3]i32{1, 2, 3};
    ia[1] += 40;
    eq_i32("element compound assign", ia[1], 42);
    ia = ia;
    eq_i32("array self assignment", ia[1], 42);

    // ---- strings in arrays ----
    names := [3]string{"a", "bb", "ccc"};
    nl : i64 = 0;
    for nm in names {
        nl += cast(i64)len(nm);
    }
    eq_i64("array of strings: total length", nl, 6);
    n2 := names[2];
    eq_i32("string taken out of an array", cast(i32)n2[1], 99);
}

fn test_pointers_heap() {
    section("pointers and heap");

    // ---- heap array of small structs ----
    buf := alloc(80);
    pts := cast(^Pt2i)buf;
    i := 0;
    while i < 10 {
        pts[i].x = cast(i32)i;
        pts[i].y = cast(i32)(i * 2);
        i += 1;
    }
    sum : i32 = 0;
    i = 0;
    while i < 10 {
        sum += pts[i].x + pts[i].y;
        i += 1;
    }
    eq_i32("heap array of Pt2i", sum, 135);
    pts[3] = Pt2i{x = 100, y = 200,};
    eq_i32("assign a struct into a pointer element", pts[3].x + pts[3].y, 300);
    p3 := pts[3];
    eq_i32("copy a struct out of a pointer element", p3.y, 200);
    free(buf);

    // ---- stride of padded elements ----
    buf2 := alloc(60);
    ps := cast(^Pad2)buf2;
    i = 0;
    while i < 10 {
        ps[i].a = cast(byte)(i + 1);
        ps[i].b = cast(i16)(i * 100);
        ps[i].c = cast(byte)(i + 11);
        i += 1;
    }
    tot : i32 = 0;
    i = 0;
    while i < 10 {
        tot += pad2_sum(ps[i]);
        i += 1;
    }
    eq_i32("heap array of 6-byte structs", tot, 4710);
    eq_i32("last element intact", cast(i32)ps[9].c, 20);
    free(buf2);

    // ---- heap array of big structs ----
    buf3 := alloc(8016);
    bp := cast(^Big)buf3;
    bp[0] = make_big(1, 2);
    bp[1] = make_big(3, 4);
    eq_i32("heap Big [0].a", bp[0].a, 1);
    eq_i32("heap Big [1].data", bp[1].data[999], 7);
    bp[1].data[500] = 9;
    eq_i32("heap Big write", bp[1].data[500], 9);
    eq_i32("heap Big neighbour untouched", bp[0].data[500], 0);
    free(buf3);

    // ---- sort structs through a pointer ----
    pa := [4]Pt2i{Pt2i{x = 5, y = 50,}, Pt2i{x = 3, y = 30,}, Pt2i{x = 8, y = 80,}, Pt2i{x = 1, y = 10,}};
    sort_pts(&pa[0], 4);
    eq_i32("sorted pts [0]", pa[0].x, 1);
    eq_i32("sorted pts [1]", pa[1].x, 3);
    eq_i32("sorted pts [2]", pa[2].x, 5);
    eq_i32("sorted pts [3]", pa[3].x, 8);
    eq_i32("y followed x", pa[0].y + pa[1].y + pa[2].y + pa[3].y, 170);
    check("y == x * 10 after sorting", pa[2].y == pa[2].x * 10);
    check("struct pointer ordering", &pa[0] < &pa[3]);

    // ---- linked list on the heap ----
    head : ^Node = 0;
    i = 1;
    while i <= 100 {
        n := cast(^Node)alloc(16);
        n^.value = cast(i32)i;
        n^.next = head;
        head = n;
        i += 1;
    }

    cnt : i32 = 0;
    lsum : i32 = 0;
    cur := head;
    while cur != 0 {
        lsum += cur^.value;
        cnt += 1;
        cur = cur^.next;
    }
    eq_i32("list length", cnt, 100);
    eq_i32("list sum", lsum, 5050);
    eq_i32("list sum (recursive)", sum_list_rec(head), 5050);
    eq_i32("list head", head^.value, 100);
}

fn test_globals_more() {
    section("globals (more)");

    eq_i32("global initialised from another global", G_CHAIN, 84);
    approx("global f64", G_F, 2.5);
    G_F = G_F * 2.0;
    approx("global f64 write", G_F, 5.0);

    eq_i32("global byte", cast(i32)G_B, 250);
    G_B = G_B + 10;
    eq_i32("global byte wraps", cast(i32)G_B, 4);

    eq_i64("global i64", G_L, 5000000000);
    G_L += 1;
    eq_i64("global i64 +=", G_L, 5000000001);

    check("global bool", G_FLAG);
    G_FLAG = false;
    check("global bool write", !G_FLAG);

    eq_i32("global small struct", G_PT.x * 10 + G_PT.y, 34);
    G_PT.y = 9;
    eq_i32("global small struct write", G_PT.x * 10 + G_PT.y, 39);
    eq_i32("global struct by value", pt_sum(G_PT), 12);

    eq_i32("global padded struct", pad2_sum(G_PAD), 6);
    G_PAD.b = 1000;
    eq_i32("global padded struct write", pad2_sum(G_PAD), 1004);

    approx("global Mat2 element", G_M2.m[3], 4.0);
    G_M2.m[0] = 9.0;
    approx("global Mat2 write", mat2_trace(G_M2), 13.0);

    eq_i64("global Quad by value", quad_sum(G_QUAD), 10);
    G_QUAD.d = 100;
    eq_i64("global Quad write", quad_sum(G_QUAD), 106);
    lq := G_QUAD;
    lq.a = 50;
    eq_i64("copy of a global is independent", G_QUAD.a, 1);

    eq_i32("global Big by value", big_checksum(G_BIG), 15);
    G_BIG.data[999] = 5;
    eq_i32("global Big write then by value", big_checksum(G_BIG), 20);
}

fn test_strings_more() {
    section("strings (more)");

    eq_i64("longer picks the longer", cast(i64)len(longer("ab", "abcd")), 4);
    eq_i32("longer: tie returns the second", cast(i32)first_char(longer("ab", "cd")), 99);
    eq_i32("first_char", cast(i32)first_char("hello"), 104);
    eq_i32("count_vowels", count_vowels("education"), 5);
    eq_i32("count_vowels of an empty string", count_vowels(""), 0);
    eq_i32("sum_digits", sum_digits("12345"), 15);
    eq_i64("len of an empty string", cast(i64)len(""), 0);

    check("str_eq equal", str_eq("abc", "abc"));
    check("str_eq different", !str_eq("abc", "abd"));
    check("str_eq different length", !str_eq("abc", "ab"));
    check("str_eq empty", str_eq("", ""));

    pairs : i32 = 0;
    for p in "abca" {
        for q in "abca" {
            if p == q {
                pairs += 1;
            }
        }
    }
    eq_i32("nested for over strings", pairs, 6);

    ns := [2]Named{Named{name = "ab", id = 1,}, Named{name = "cde", id = 2,}};
    nt : i64 = 0;
    for nn in ns {
        nt += named_len(nn);
    }
    eq_i64("array of Named", nt, 8);
    eq_i64("string returned out of a struct", cast(i64)len(named_name(ns[1])), 3);

    eq_i64("strlen of a literal", cast(i64)strlen(&("hello world")[0]), 11);

    // ---- C varargs ----
    buf := [64]byte{};

    l : i64 = 5000000000;
    n1 := snprintf(&buf[0], 64, &("%lld")[0], l);
    eq_i32("%lld length", n1, 10);
    eq_i32("%lld output", strcmp(&buf[0], &("5000000000")[0]), 0);

    d : f64 = 3.14159;
    n2 := snprintf(&buf[0], 64, &("%.2f")[0], d);
    eq_i32("%.2f length", n2, 4);
    eq_i32("%.2f output", strcmp(&buf[0], &("3.14")[0]), 0);

    u : u32 = 255;
    n3 := snprintf(&buf[0], 64, &("%x")[0], u);
    eq_i32("%x output", strcmp(&buf[0], &("ff")[0]), 0);

    u2 : u32 = 4000000000;
    n4 := snprintf(&buf[0], 64, &("%u")[0], u2);
    eq_i32("%u output", strcmp(&buf[0], &("4000000000")[0]), 0);

    t := true;
    n5 := snprintf(&buf[0], 64, &("%d")[0], t);
    eq_i32("bool promoted to int", strcmp(&buf[0], &("1")[0]), 0);

    ch : byte = 65;
    n6 := snprintf(&buf[0], 64, &("%c")[0], ch);
    eq_i32("%c with a byte", strcmp(&buf[0], &("A")[0]), 0);

    n7 := snprintf(&buf[0], 64, &("%d %d %d %d %d %d %d %d")[0],
        cast(i32)1, cast(i32)2, cast(i32)3, cast(i32)4, cast(i32)5, cast(i32)6, cast(i32)7, cast(i32)8);
    eq_i32("8 varargs (some on the stack)", strcmp(&buf[0], &("1 2 3 4 5 6 7 8")[0]), 0);

    n8 := snprintf(&buf[0], 64, &("%s=%d")[0], &("key")[0], cast(i32)7);
    eq_i32("%s=%d output", strcmp(&buf[0], &("key=7")[0]), 0);
}

fn test_loop_stack_more() {
    section("stack stays flat in long loops (more)");

    i := 0;
    acc : i64 = 0;
    while i < 500 {
        acc += huge_sum(huge_make(6));
        i += 1;
    }
    eq_i64("500 x 40 KiB temporaries", acc, 15000000);

    k : i32 = 1;
    d : f64 = 2.5;
    flag := true;
    acc = 0;
    i = 0;
    while i < 100000 {
        acc += count_args(k, d, "text", flag);
        i += 1;
    }
    eq_i64("100k ..any calls (boxing in a loop)", acc, 400000);

    acc = 0;
    i = 0;
    while i < 100000 {
        acc += cast(i64)sum_var(1, 2, 3, 4);
        i += 1;
    }
    eq_i64("100k variadic calls", acc, 1000000);

    acc = 0;
    i = 0;
    while i < 20000 {
        acc += cast(i64)sum_bigs_wrapper();
        i += 1;
    }
    eq_i64("20k ..Big calls", acc, 240000);

    p := Pt2i{x = 1, y = 2,};
    i = 0;
    while i < 100000 {
        p = apply_pt(pt_swap, p);
        i += 1;
    }
    eq_i32("100k small struct calls through a fn pointer", p.x * 10 + p.y, 12);

    acc = 0;
    i = 0;
    while i < 50000 {
        acc += cast(i64)bm_check(bm_make());
        i += 1;
    }
    eq_i64("50k BigMixed sret calls", acc, 56300000);

    acc = 0;
    i = 0;
    while i < 100000 {
        acc += quad_sum(quad_make(cast(i64)i));
        i += 1;
    }
    eq_i64("100k Quad calls", acc, 20000400000);

    acc = 0;
    i = 0;
    while i < 100000 {
        r := rec_make(1, 0.5, "abc", true);
        acc += rec_weight(r);
        i += 1;
    }
    eq_i64("100k Rec calls", acc, 400000);
}

// ==== OPTIONAL SYNTAX BLOCK (START) =========================
// Delete everything down to the END marker, and the call in
// main(), if any of this doesn't compile yet.

fn void_early(n: i32) {
    if n > 5 {
        G_COUNTER += 100;
        return;
    }

    G_COUNTER += 1;
}

fn pick_op(which: i32): fn(a: i32): i32 {
    if which == 0 {
        return twice;
    }

    return thrice;
}

fn add_inf(a: i32, b : i32 = 7): i32 {
    return a + b;
}

fn test_optional_syntax() {
    section("optional syntax (delete this block if it doesn't compile)");

    // ---- bitwise ----
    a : i32 = 12;
    b : i32 = 10;
    eq_i32("bit and", a & b, 8);
    eq_i32("bit or", a | b, 14);

    // ---- compound assignment ----
    x : i32 = 100;
    x -= 30;
    x *= 2;
    x /= 4;
    x %= 10;
    eq_i32("-= *= /= %=", x, 5);

    // ---- bare return in a void function ----
    G_COUNTER = 0;
    void_early(10);
    void_early(1);
    eq_i32("void early return", G_COUNTER, 101);

    // ---- fn type as a return type ----
    f := pick_op(0);
    g := pick_op(1);
    eq_i32("fn returning a fn pointer", f(4) + g(4), 20);

    // ---- inferred default parameter ----
    eq_i32("inferred default used", add_inf(1), 8);
    eq_i32("inferred default overridden", add_inf(1, 2), 3);

    // ---- void lambda ----
    bump := fn() { G_COUNTER += 1; };
    G_COUNTER = 0;
    bump();
    bump();
    eq_i32("void lambda", G_COUNTER, 2);

    // ---- pointer <-> integer ----
    buf := alloc(8);
    addr := cast(i64)buf;
    back := cast(^byte)addr;
    check("pointer -> int -> pointer", back == cast(^byte)buf);
    check("allocated pointer is nonzero as an int", addr != 0);
    free(buf);
}

// ==== OPTIONAL SYNTAX BLOCK (END) ===========================


