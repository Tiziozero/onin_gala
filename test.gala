fn main(): i32 {
    println("Gala extended test suite");

    test_int_edge();
    test_casts_more();
    test_float_more();
    test_eval_order();
    test_control_more();
    test_functions_more();
    test_fn_pointers_more();
    test_variadics_more();
    test_variadic_structs();
    test_sizeof_all();
    test_layout_bytes();
    test_small_structs_abi();
    test_small_struct_semantics();
    test_many_args();
    test_medium_structs();
    test_size_boundary();
    test_big_structs_more();
    test_arrays_more();
    test_pointers_heap();
    test_globals_more();
    test_strings_more();
    test_loop_stack_more();
    test_optional_syntax();

    println("----");
    println("passed:", passed, "failed:", failed);

    if failed == 0 {
        println("ALL TESTS PASSED");
    } else {
        println("SOME TESTS FAILED");
    }

    return failed;
}
