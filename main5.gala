import "core/core.gala";
import "core/dynamic_array.gala";


fn generic_item(a: $T): T {
    return a;
}

fn main() {
    xs := dyn_make(4, 0);              // DynArray(i64), T from the literal
    n := 0;
    while n < 10 {
        dyn_push(&xs, n * n);
        n += 1;
    }
    println("3rd element:", dyn_get(&xs, 3));          // 9
    for v in dyn_slice(&xs)[:3] { println(v); }
}
